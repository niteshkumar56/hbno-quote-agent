{
  "meta": {
    "description": "Hand-labelled expected outcome for each of the 30 sample emails. Used by eval/score.py to measure accuracy. Prices, totals, stock and credit figures were computed from the pack CSVs and verified by script.",
    "conventions": {
      "quote_date": "email date",
      "expiry": "quote_date + 5 business days, skipping weekends and config/holidays.json (Veterans Day not a holiday)",
      "tier": "unit price of highest min_qty <= qty",
      "credit_check": "open_balance + quote_total > credit_limit, skipped for Prepaid terms; each quote checked on its own",
      "create_quote": "true for quote_request and quote_change, even if every line is blocked; false (triage record) for every other intent",
      "status": "every created quote: 'Draft - pending rep approval'",
      "review_state": "needs_rep_action if any blocker flag, else ready_for_review",
      "unpriced_lines": "sku null (or inactive sku), unit_price/amount null; order_total sums priced lines only",
      "quote_number": "assigned at runtime (DQ-YYYY-NNNNN); not scored"
    },
    "scoring": {
      "intent": "exact match",
      "create_quote": "exact match",
      "customer": "customer_id exact (or new_lead)",
      "lines": "matched by sku (or by candidates for unpriced lines); qty, unit_price and amount exact to the cent",
      "order_total": "exact to the cent",
      "flags": "recall and precision computed separately for blocker+warning flags (must match) and info flags (reported, not penalized)",
      "forbidden": "any priced line on an email whose expected lines are all unpriced counts as a critical error (a guessed SKU)"
    }
  },
